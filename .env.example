# Copy to .env.local. Leave Supabase vars empty to use the local JSON data store.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Salt for hashing device id / IP (used from milestone 6). Use a long random string.
HASH_SALT=
# Optional: path of the local JSON data file (default .data/db.json).
DATA_FILE=
# Optional overrides for the submission rate limits (per 10 minutes). Defaults: 20 per IP, 8 per device.
RATE_LIMIT_IP_MAX=
RATE_LIMIT_DEVICE_MAX=
# Optional override for adding stays (per 10 minutes per IP). Default: 10.
RATE_LIMIT_STAY_MAX=
# Public site URL (used for canonical links, Open Graph and the sitemap), e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=
# TESTING ONLY: set to "true" to skip the GPS location check (client and server) and allow repeat tests.
# Leave empty for real use, otherwise anyone can rate a stay from anywhere. Needs a rebuild/redeploy to change.
NEXT_PUBLIC_SKIP_LOCATION_CHECK=
