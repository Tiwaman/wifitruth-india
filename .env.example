# Copy to .env.local. Leave Supabase vars empty to use the local JSON data store.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Salt for hashing device id / IP (used from milestone 6). Use a long random string.
HASH_SALT=
# Optional: path of the local JSON data file (default .data/db.json).
DATA_FILE=
# Optional overrides for the submission rate limits (per 10 minutes). Defaults: 20 per IP, 8 per device.
RATE_LIMIT_IP_MAX=
RATE_LIMIT_DEVICE_MAX=
